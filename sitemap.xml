    <video:video>
      <video:thumbnail_loc>https://33bots.lt/video/33bots-robot-event-poster.jpg</video:thumbnail_loc>
      <video:title>Robotas renginyje — pilnas pasirodymas</video:title>
      <video:description>Humanoidinis robotas Unitree G1 renginyje: vaikšto tarp svečių, gestikuliuoja, pozuoja nuotraukoms ir atlieka choreografiją. Ant krūtinės — kliento logotipas ir QR kodas.</video:description>
      <video:content_loc>https://33bots.lt/video/33bots-robot-event.mp4</video:content_loc>
      <video:family_friendly>yes</video:family_friendly>
    </video:video>
    <video:video>
      <video:thumbnail_loc>https://33bots.lt/video/robot-powitanie-poster.jpg</video:thumbnail_loc>
      <video:title>Svečių pasitikimas</video:title>
      <video:description>Robotas pasitinka atvykstančius svečius prie įėjimo — mostas, nusilenkimas ir pozavimas nuotraukoms. Populiariausias renginio pradžios scenarijus.</video:description>
      <video:content_loc>https://33bots.lt/video/robot-powitanie.mp4</video:content_loc>
      <video:family_friendly>yes</video:family_friendly>
    </video:video>
    <video:video>
      <video:thumbnail_loc>https://33bots.lt/video/robot-taniec-poster.jpg</video:thumbnail_loc>
      <video:title>Šokio choreografija</video:title>
      <video:description>Unitree G1 atlieka šokio choreografiją. Toks pasirodymas dažniausiai tampa gala vakaro ar įmonės šventės kulminacija.</video:description>
      <video:content_loc>https://33bots.lt/video/robot-taniec.mp4</video:content_loc>
      <video:family_friendly>yes</video:family_friendly>
    </video:video>
    <video:video>
      <video:thumbnail_loc>https://33bots.lt/video/robot-gesty-poster.jpg</video:thumbnail_loc>
      <video:title>Gestai ir bendravimas</video:title>
      <video:description>Roboto gestai iš arti: rankos paspaudimas, mostai ir judesiai, kuriais robotas bendrauja su svečiais. 43 laisvės laipsniai judesio sklandumui.</video:description>
      <video:content_loc>https://33bots.lt/video/robot-gesty.mp4</video:content_loc>
      <video:family_friendly>yes</video:family_friendly>
    </video:video>
    <video:video>
      <video:thumbnail_loc>https://33bots.lt/video/robot-spacer-poster.jpg</video:thumbnail_loc>
      <video:title>Judėjimas erdvėje</video:title>
      <video:description>Robotas juda po renginio erdvę tarp žmonių, apeidamas kliūtis. LiDAR jutikliai ir operatoriaus priežiūra užtikrina saugų darbą minioje.</video:description>
      <video:content_loc>https://33bots.lt/video/robot-spacer.mp4</video:content_loc>
      <video:family_friendly>yes</video:family_friendly>
    </video:video>
    <video:video>
      <video:thumbnail_loc>https://33bots.lt/video/robot-branding-poster.jpg</video:thumbnail_loc>
      <video:title>Ženklinimas prekės ženklu</video:title>
      <video:description>Roboto ženklinimas kliento logotipu ir QR kodu ant krūtinės. Įskaičiuota į nuomos kainą — kiekvienas svečio įrašas dirba jūsų prekės ženklui.</video:description>
      <video:content_loc>https://33bots.lt/video/robot-branding.mp4</video:content_loc>
      <video:family_friendly>yes</video:family_friendly>
    </video:video>
